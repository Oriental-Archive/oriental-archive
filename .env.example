# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (used directly by the app, and by docker-compose to init the container) ---
POSTGRES_USER=oriental_archive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oriental_archive
DATABASE_URL="postgresql://oriental_archive:change-me@localhost:5432/oriental_archive?schema=public"

# --- Better-Auth ---
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=change-me-to-a-long-random-value
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, or local MinIO via docker-compose) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=oriental-archive-files
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
# true for MinIO/most self-hosted S3-compatible stores, false for AWS S3/R2
STORAGE_FORCE_PATH_STYLE=true

# Upload limits, the homepage announcement, contact email, and featured
# books/reading paths are configured at /librarian/site-settings, not here
# — see src/lib/site-settings.ts.

# --- Master Librarian seed account ---
# Used ONLY by `npm run seed:master-librarian`, one time, to create the single
# protected Master Librarian account. Rotate/remove after first use.
MASTER_LIBRARIAN_USERNAME=change-me
MASTER_LIBRARIAN_EMAIL=change-me@example.com
MASTER_LIBRARIAN_PASSWORD=change-me-to-a-strong-password
